{
  "name": "@channel-foundry/studio",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && cross-env CHANNEL_FOUNDRY_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "verify:data-paths": "node verify-studio-data-paths.cjs",
    "verify:web-connection": "node verify-web-connection.cjs",
    "verify:ytdlp": "node verify-ytdlp-manager.cjs"
  },
  "dependencies": {
    "@channel-foundry/domain": "*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wait-on": "^8.0.4"
  }
}
